# Beispiel-Konfiguration für Ultimate Dash
# Kopieren nach .env und anpassen: cp .env.example .env
# docker compose liest .env automatisch und reicht die Werte an den Container weiter.
# Alles ist optional. Leere oder auskommentierte Werte = Standard bzw. Einstellung in der Oberfläche.
# Erklärung aller Variablen: docs/anleitungen/konfiguration.md
# Diese Datei nie mit echten Werten committen (.env steht in .gitignore).

# --- Allgemein ---
# LOG_LEVEL=info
# LOG_REQUESTS=false
# STATUS_INTERVAL_SECONDS=60
# STATUS_TIMEOUT_MS=5000
# FEED_INTERVAL_MINUTES=30

# Adresse, unter der das Dashboard erreichbar ist (Pflicht für Links in Mails)
# PUBLIC_URL=https://dash.example.org

# --- Technitium DNS (sonst in der Oberfläche) ---
# TECHNITIUM_URL=http://192.168.1.53:5380
# TECHNITIUM_TOKEN=
# TECHNITIUM_TLS_INSECURE=false

# --- Proxmox VE (sonst in der Oberfläche) ---
# PROXMOX_URL=https://pve.home.lan:8006
# PROXMOX_TOKEN_ID=dashboard@pve!ultimate-dash
# PROXMOX_TOKEN_SECRET=
# PROXMOX_TLS_INSECURE=false

# --- Mailserver (sonst in der Oberfläche) ---
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_ENCRYPTION=starttls
# SMTP_USER=dash@example.org
# SMTP_PASSWORD=
# SMTP_FROM=Ultimate Dash <dash@example.org>
# SMTP_TLS_INSECURE=false

# --- Anmeldung über OIDC ---
# OIDC_ISSUER=https://auth.example.org/application/o/ultimate-dash/
# OIDC_CLIENT_ID=ultimate-dash
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_SCOPES=openid profile email
# OIDC_BUTTON_LABEL=Mit SSO anmelden
# OIDC_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUPS=
# OIDC_ALLOWED_GROUPS=
# OIDC_AUTO_CREATE=true
# OIDC_LINK_BY_USERNAME=false
# OIDC_TLS_INSECURE=false

# Update-Prüfung (Einstellungen › Updates): nur Abfrage der GitHub-Veröffentlichungen
# UPDATE_CHECK=false
# UPDATE_REPO=myrillian/ultimate-dash
