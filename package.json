{
  "name": "ultimate-dash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @ultimate-dash/web build && pnpm --filter @ultimate-dash/server build",
    "start": "pnpm --filter @ultimate-dash/server start",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "~5.9.3"
  }
}
